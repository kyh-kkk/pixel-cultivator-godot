; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section]
;   param1=value1
;   param2=value2

config_version=5

[application]

config/name="Pixel Cultivator"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameManager="*res://scripts/core/game_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
SceneLoader="*res://scripts/core/scene_loader.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
QuestManager="*res://scripts/systems/quest_manager.gd"
AchievementManager="*res://scripts/systems/achievement_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"

[input]

move_left={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=65,unicode=97), Object(InputEventKey,physical_keycode=4194319,unicode=0)]}
move_right={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=68,unicode=100), Object(InputEventKey,physical_keycode=4194321,unicode=0)]}
jump={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=32,unicode=32)]}
dash={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=4194325,unicode=0)]}
attack={"deadzone": 0.5, "events": [Object(InputEventMouseButton,button_index=1), Object(InputEventKey,physical_keycode=74,unicode=106)]}
skill_1={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=75,unicode=107)]}
skill_2={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=76,unicode=108)]}
skill_3={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=85,unicode=117)]}
interact={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=69,unicode=101)]}
inventory={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=73,unicode=105)]}
quest_log={"deadzone": 0.5, "events": [Object(InputEventKey,physical_keycode=81,unicode=113)]}
